    "/api/v1/demo/examples": {
      "get": {
        "operationId": "get_examples_api_v1_demo_examples_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DemoExampleResponse"
                  },
                  "title": "Response Get Examples Api V1 Demo Examples Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Get Examples",
        "tags": [
          "Local inspection demo"
        ]
      },
      "post": {
        "operationId": "create_example_api_v1_demo_examples_post",
        "parameters": [
          {
            "in": "query",
            "name": "part_id",
            "required": true,
            "schema": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Part Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "label",
            "required": true,
            "schema": {
              "enum": [
                "PASS",
                "FAIL"
              ],
              "title": "Label",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "image/jpeg": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoExampleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Create Example",
        "tags": [
          "Local inspection demo"
        ]
      }
    },
    "/api/v1/demo/examples/{example_id}/image": {
      "get": {
        "operationId": "get_example_image_api_v1_demo_examples__example_id__image_get",
        "parameters": [
          {
            "in": "path",
            "name": "example_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Example Id",
