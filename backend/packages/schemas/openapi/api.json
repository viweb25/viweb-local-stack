          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Example Image",
        "tags": [
          "Local inspection demo"
        ]
      }
    },
    "/api/v1/demo/{engine}": {
      "post": {
        "operationId": "inspect_api_v1_demo__engine__post",
        "parameters": [
          {
            "in": "path",
            "name": "engine",
            "required": true,
            "schema": {
              "enum": [
                "inspect",
                "detect",
                "analyze"
              ],
              "title": "Engine",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "origin",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Origin"
            }
          }
        ],
        "requestBody": {
          "content": {
            "image/jpeg": {
              "schema": {
