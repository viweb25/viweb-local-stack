  "info": {
    "title": "VI WebSync Inference",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/demo/analyze": {
      "post": {
        "operationId": "analyze_image_api_v1_demo_analyze_post",
        "parameters": [
          {
            "in": "query",
            "name": "confidence",
            "required": false,
            "schema": {
              "default": 0.5,
              "maximum": 1,
              "minimum": 0.01,
              "title": "Confidence",
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "content": {
            "image/jpeg": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageAnalysis"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze Image",
        "tags": [
          "Object detection"
        ]
      }
    },
    "/api/v1/demo/detect": {
      "post": {
        "operationId": "inspect_objects_api_v1_demo_detect_post",
        "parameters": [
          {
            "in": "query",
            "name": "target",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Target",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "expected_count",
            "required": true,
            "schema": {
              "maximum": 999,
              "minimum": 1,
              "title": "Expected Count",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "confidence",
            "required": false,
            "schema": {
              "default": 0.5,
              "maximum": 1,
              "minimum": 0.01,
              "title": "Confidence",
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "content": {
            "image/jpeg": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inspect Objects",
        "tags": [
          "Object detection"
        ]
      }
    },
    "/api/v1/demo/detection-model": {
      "get": {
        "operationId": "detection_model_api_v1_demo_detection_model_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Detection Model",
        "tags": [
          "Object detection"
        ]
      }
    },
    "/api/v1/demo/inspect": {
      "post": {
        "operationId": "inspect_image_api_v1_demo_inspect_post",
        "parameters": [
          {
            "in": "query",
            "name": "rule",
            "required": true,
            "schema": {
              "maxLength": 400,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Rule",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "image/jpeg": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inspect Image",
        "tags": [
          "Visual inspection demo"
        ]
      }
    },
    "/api/v1/predict": {
      "post": {
        "description": "No approved model is loaded. Never fabricate a successful inspection.",
        "operationId": "predict_api_v1_predict_post",
        "responses": {
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Predict"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    }
  }
}
