{
  "components": {
    "schemas": {
      "Detection": {
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "x1": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X1",
            "type": "number"
          },
          "x2": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X2",
            "type": "number"
          },
          "y1": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y1",
            "type": "number"
          },
          "y2": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y2",
            "type": "number"
          }
        },
        "required": [
          "label",
          "confidence",
          "x1",
          "y1",
          "x2",
          "y2"
