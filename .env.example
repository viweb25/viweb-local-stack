# Optional build contexts for independent checkouts. Use the business backend
# branch inspection-onboarding with the current auth and inspection routes.
# BACKEND_CONTEXT=../viweb-ai
# DATABASE_CONTEXT=../viweb-db
# INFERENCE_CONTEXT=../viweb-inference

# Make subsequent Compose starts load models/best.pt.
# INFERENCE_TARGET=yolo

# Set these if your host UID/GID differ from 1000.
# TRAIN_UID=1000
# TRAIN_GID=1000

# Directory containing the extracted YOLO export and data.yaml.
# DATASET_DIR=./datasets
